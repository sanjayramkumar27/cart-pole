<mujoco>
<option gravity="0 0 -9.81"/>

<asset>
    
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1=".2 .3 .4" rgb2=".1 .2 .3" markrgb=".8 .8 .8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance=".2"/>
  </asset>

<worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <geom name="rail_left"  type="cylinder" fromto="-2.4  0.12 1.2  2.4  0.12 1.2" size="0.02"
          rgba="0.7 0.7 0.75 1" contype="0" conaffinity="0"/>
    <geom name="rail_right" type="cylinder" fromto="-2.4 -0.12 1.2  2.4 -0.12 1.2" size="0.02"
          rgba="0.7 0.7 0.75 1" contype="0" conaffinity="0"/>

    <geom type="capsule" fromto="-2.4  0.12 0  -2.4  0.12 1.2" size="0.03" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto="-2.4 -0.12 0  -2.4 -0.12 1.2" size="0.03" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto=" 2.4  0.12 0   2.4  0.12 1.2" size="0.03" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto=" 2.4 -0.12 0   2.4 -0.12 1.2" size="0.03" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>

    

    <body name="box" pos="0 0 1.2">
        <geom type="capsule" size="0.08 0.25" euler ="0 90 0" rgba="0.8 0.3 0.3 1" mass="1"/>
        <joint type="slide" axis="1 0 0" name="slide_x" range="-2 2"/>
        <body name="pendulum" pos="0 0 0">
            <geom type="cylinder" fromto="0 0 0 0 0 1" size="0.03" rgba="0.3 1 0.5 1" mass="0.1"/>
            <joint type="hinge" axis="0 1 0" name="hinge_y"/>
        </body>
    </body>
</worldbody>

<actuator>
    <motor  name="slide_x" joint="slide_x" ctrlrange="-10 10"/>
</actuator>
</mujoco>